# Reject commits that include unresolved git conflict markers.
# Pattern: ^<<<<<<<, ^=======$, ^>>>>>>>.
# Searched against the staged diff (added lines only) to avoid false positives
# in source files that legitimately contain these strings (e.g. tests, docs
# about merging).
if git diff --cached -U0 | grep -nE '^\+(<<<<<<<|=======|>>>>>>>)( |$)' >&2; then
  echo "error: staged content includes unresolved git conflict markers" >&2
  exit 1
fi
