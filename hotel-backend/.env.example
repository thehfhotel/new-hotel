# Legacy Database (SQL Server - read-only)
DB_SERVER=<legacy-mssql-host>
DB_NAME=db
DB_USER=sa
# REQUIRED — backend panics at startup if unset or empty (no fallback).
DB_PASSWORD=REDACTED-sa-pw
# TCP port. Default 1433 (HF Hotel). HF Ville uses 1436 (its SS2025 Express
# instance does not listen on the default port).
MSSQL_PORT=1433
# Shared bb8-tiberius pool max (writeback + sync + ville-sync).
# Default 20. Legacy alias `DB_POOL_MAX` still honored if set.
MSSQL_POOL_MAX_SIZE=20

# New Database (PostgreSQL - HotelNew)
NEW_DB_SERVER=localhost
NEW_DB_PORT=5439
NEW_DB_NAME=hotelnew
NEW_DB_USER=postgres
NEW_DB_PASSWORD=REDACTED-sa-pw

# DATABASE_URL for sqlx macros (compile-time verification)
DATABASE_URL=postgresql://postgres:REDACTED-sa-pw@localhost:5439/hotelnew

# Server Configuration
HOST=0.0.0.0
PORT=3003

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx
SLACK_NOTIFICATIONS_ENABLED=true
