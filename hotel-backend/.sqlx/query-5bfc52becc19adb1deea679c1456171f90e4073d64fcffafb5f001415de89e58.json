  "query": "SELECT ri.ri_id, ri.ri_room_id, ri.ri_item_id, i.item_code, i.item_name, ri.ri_quantity, ri.ri_last_checked\n        FROM ht_room_inventory ri\n        LEFT JOIN ht_inventory_items i ON ri.ri_item_id = i.item_id\n        WHERE ri.ri_room_id = $1\n        ORDER BY i.item_name ASC",
