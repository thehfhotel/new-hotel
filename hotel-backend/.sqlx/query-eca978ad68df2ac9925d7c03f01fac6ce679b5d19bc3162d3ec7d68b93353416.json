  "query": "\n        SELECT book_id,\n               book_no,\n               COALESCE(book_status, 'pending') AS \"status!\",\n               book_channel,\n               book_cust_id,\n               book_checkin,\n               book_checkout,\n               COALESCE(book_total_amount, 0)::float8 AS \"total_amount!\",\n               COALESCE(book_deposit_amount, 0)::float8 AS \"deposit_amount!\",\n               book_hold_expires_at\n          FROM ht_bookings\n         WHERE book_id = $1\n        ",
