# syntax=docker/dockerfile:1.7
#
# ville-sync image — see ./Dockerfile for the full caching-strategy comment.
# Same BuildKit cache-mount pattern; sharing the `hotel-backend-target` cache
# id means a build of either image warms the other (target/ is workspace-wide).

# Pin to digest (Batch C of post-Phase-5.5 audit). Source: Docker Hub API
# `hub.docker.com/v2/repositories/library/rust/tags/1.89-bookworm` on 2026-04-26.
FROM rust:1.95-bookworm@sha256:adab7941580c74513aa3347f2d2a1f975498280743d29ec62978ba12e3540d3a AS builder
LABEL org.opencontainers.image.source=https://github.com/thehfhotel/new-hotel
LABEL org.opencontainers.image.licenses=Proprietary
RUN apt-get update \
    && apt-get install -y --no-install-recommends mold clang \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /usr/src/app

ENV SQLX_OFFLINE=true
ENV CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse

COPY . .

RUN --mount=type=cache,target=/usr/local/cargo/registry,id=cargo-registry \
    --mount=type=cache,target=/usr/local/cargo/git,id=cargo-git \
    --mount=type=cache,target=/usr/src/app/target,id=hotel-backend-target \
    cargo build --release --locked --bin ville_sync \
    && mkdir -p /out \
    && cp target/release/ville_sync /out/

# ---- Runtime stage --------------------------------------------------------
# Pin to digest. Source: `library/debian/tags/bookworm-slim` on 2026-04-26.
FROM debian:bookworm-slim@sha256:f9c6a2fd2ddbc23e336b6257a5245e31f996953ef06cd13a59fa0a1df2d5c252
LABEL org.opencontainers.image.source=https://github.com/thehfhotel/new-hotel
LABEL org.opencontainers.image.licenses=Proprietary

RUN apt-get update && apt-get install -y \
    ca-certificates \
    freetds-bin \
    locales \
    && sed -i '/en_US.UTF-8/s/^# //' /etc/locale.gen && locale-gen \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /out/ville_sync /app/ville_sync

RUN useradd -m -u 1000 appuser
USER appuser

ENV RUST_LOG=ville_sync=info
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# ville_sync has no HTTP endpoint and no liveness sentinel today — process
# liveness is the only honest signal. We declare a no-op HEALTHCHECK so
# the container always reports `healthy` (i.e. up) under `docker ps`,
# which keeps any orchestrator that filters on health-status from
# false-flagging the container. A proper deeper probe (sentinel file
# touched per poll-loop iteration in the binary) is tracked as a
# follow-up — see Batch E candidates in the audit notes.
HEALTHCHECK --interval=120s --timeout=5s CMD true

CMD ["./ville_sync"]
