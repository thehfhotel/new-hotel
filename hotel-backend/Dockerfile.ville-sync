# syntax=docker/dockerfile:1.7
#
# ville-sync image — same chef/planner/builder pattern as ./Dockerfile, but the
# final `cargo build` selects the `ville_sync` bin target. Deps cooked via
# cargo-chef are shared across all bins in the workspace, so this layer is
# cache-compatible with the main backend build when both run on the same
# BuildKit cache.

FROM rust:1.89-bookworm AS chef
RUN apt-get update \
    && apt-get install -y --no-install-recommends mold clang \
    && rm -rf /var/lib/apt/lists/*
RUN cargo install cargo-chef --locked
WORKDIR /usr/src/app

# ---- Plan stage -----------------------------------------------------------
FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# ---- Build stage ----------------------------------------------------------
FROM chef AS builder
ENV SQLX_OFFLINE=true

COPY --from=planner /usr/src/app/recipe.json recipe.json
RUN cargo chef cook --release --recipe-path recipe.json

COPY . .
RUN cargo build --release --bin ville_sync

# ---- Runtime stage --------------------------------------------------------
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    freetds-bin \
    locales \
    && sed -i '/en_US.UTF-8/s/^# //' /etc/locale.gen && locale-gen \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /usr/src/app/target/release/ville_sync /app/ville_sync

RUN useradd -m -u 1000 appuser
USER appuser

ENV RUST_LOG=ville_sync=info
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

CMD ["./ville_sync"]
