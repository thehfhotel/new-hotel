# Build stage (shared with hotel-backend Dockerfile)
FROM rust:1.85-bookworm AS builder

WORKDIR /usr/src/app

ENV SQLX_OFFLINE=true

COPY Cargo.toml Cargo.lock* ./

# Create dummy sources matching Cargo.toml bin targets to cache dependencies
RUN mkdir -p src/bin && echo "fn main() {}" > src/main.rs && echo "fn main() {}" > src/bin/migrate_legacy.rs && echo "fn main() {}" > src/bin/ville_sync.rs
RUN cargo build --release
RUN rm -rf src

COPY .sqlx .sqlx
COPY src ./src

RUN find src -name "*.rs" -exec touch {} + && cargo build --release --bin ville_sync

# Runtime stage
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    freetds-bin \
    locales \
    && sed -i '/en_US.UTF-8/s/^# //' /etc/locale.gen && locale-gen \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /usr/src/app/target/release/ville_sync /app/ville_sync

RUN useradd -m -u 1000 appuser
USER appuser

ENV RUST_LOG=ville_sync=info
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

CMD ["./ville_sync"]
