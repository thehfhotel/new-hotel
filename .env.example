# =============================================================================
# Database Configuration
# =============================================================================

# Legacy Database (external server - shared with legacy application)
# This connects to the existing SQL Server at <legacy-mssql-host>
# Tables in this database are READ-ONLY (do not modify schema)
DB_SERVER=<legacy-mssql-host>
DB_NAME=db
DB_USER=sa
# REQUIRED — backend panics at startup if unset or empty (no fallback).
DB_PASSWORD=your_db_password_here
# TCP port. Default 1433 (HF Hotel). HF Ville uses 1436 (its SS2025
# Express instance does not listen on the default port).
MSSQL_PORT=1433

# New Database (PostgreSQL container)
# This connects to the PostgreSQL container defined in docker-compose.yml
# Use "newdb" as the server name when running in Docker (container DNS name)
# Use "localhost" when connecting from outside Docker
NEW_DB_SERVER=newdb
NEW_DB_PORT=5439
NEW_DB_NAME=hotelnew
NEW_DB_USER=postgres
NEW_DB_PASSWORD=your_new_db_password_here

# PostgreSQL container settings (used by docker-compose for the newdb service)
POSTGRES_DB=hotelnew
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_new_db_password_here

# =============================================================================
# System Mode
# =============================================================================
# Controls which database is primary for operations
# - 'legacy': Use legacy database (default, for backward compatibility)
# - 'new': Use new database (HotelNew) as primary
SYSTEM_MODE=legacy

# =============================================================================
# Writeback Worker (Phase 4b — drains writeback_jobs into legacy MSSQL)
# =============================================================================
# Per docs/architecture.md §3.6c, §6, §8. The writeback worker is registered
# under the docker-compose `legacy` profile — only started when you run
# `docker compose --profile legacy up -d`. Set to `false` for State C
# (decommissioned) so the worker exits cleanly on startup.
WRITEBACK_ENABLED=true
WRITEBACK_POLL_INTERVAL_SECS=30
WRITEBACK_MAX_ATTEMPTS=3

# =============================================================================
# Slack Notifications
# =============================================================================
# Get your webhook URL from https://api.slack.com/apps
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx
SLACK_NOTIFICATIONS_ENABLED=true

# =============================================================================
# Card Reader Middleware
# =============================================================================
# URL of the card reader middleware service (set at build time)
# Leave empty for localhost:9898 (local development)
# Set to public URL for production (e.g., https://card-reader.thehfhotel.org)
NEXT_PUBLIC_CARD_READER_URL=

# =============================================================================
# Housekeeping ops app (แจ้งซ่อม / เบิกของ deep links from /hk)
# =============================================================================
# Base URL of the separate Housekeeping ops app. Leave empty to default to
# https://housekeeping.thehfhotel.org (set at build time).
NEXT_PUBLIC_HOUSEKEEPING_URL=

# =============================================================================
# NFC staff-card login (tap card → PMS session). See service::reader.
# =============================================================================
# The physical reader posts taps to CENTRAL HF-ID, not to this PMS. The PMS
# consumes HF-ID's pairing endpoints (/api/private/reader/claim|wait) on behalf
# of the login screen and verifies the returned RS256 assertion.
#
# PMS ↔ central HF-ID shared secret, sent in the X-Reader-Secret header on the
# claim/wait calls. UNSET/empty ⇒ every claim/wait is rejected (fail closed).
READER_RESOLVE_SECRET=
# Base URL of the central HF-ID service (claim/wait + the {base}/oidc/jwks
# assertion-verification keys). Default: http://192.168.1.250 — set to the real
# central host on any real deploy.
HFID_BASE_URL=http://192.168.1.250
# Per-terminal reader id the login screen pairs to (frontend, build-time
# default; can be overridden per terminal via the login "pair" input →
# localStorage `reader_id`).
NEXT_PUBLIC_READER_ID=

# =============================================================================
# Backend Service (internal)
# =============================================================================
# URL for frontend to connect to backend (used in docker-compose)
BACKEND_URL=http://backend:3003

# Backend server configuration
HOST=0.0.0.0
PORT=3003

# =============================================================================
# Loyalty-app integration (docs/loyalty-channel.md)
# =============================================================================
# Inbound booking channel (/api/channel/*) — SHIPS DARK. Both the flag AND the
# shared bearer token must be set before the loyalty app can quote
# availability / create holds. A channel hold writes back to iHOTEL as a
# normal booking (จอง), so flipping this on is a reception-coordinated
# go-live step (coexistence invariant #6), not just config.
LOYALTY_CHANNEL_ENABLED=false
# Shared bearer the loyalty app presents as `Authorization: Bearer <token>`.
# UNSET/empty ⇒ every /api/channel/* request is rejected (fail closed).
# Also available as Docker secret file `loyalty_channel_token` (env wins).
LOYALTY_CHANNEL_TOKEN=

# Outbound checkout→loyalty stay hook: POST {LOYALTY_APP_URL}/api/loyalty/stays
# for membership-linked guests on checkout. OFF unless BOTH are set.
# Best-effort with retries — never blocks a checkout.
LOYALTY_APP_URL=
# Bearer for the stay hook. Also available as Docker secret file
# `loyalty_service_token` (env wins).
LOYALTY_SERVICE_TOKEN=

# =============================================================================
# OTA booking bridge (docs/ota-bridge.md)
# =============================================================================
# The MACHINE surface `ota-desk` calls: the five existing booking/customer/room
# handlers re-mounted under /api/ota/* behind a shared bearer, plus
# GET /api/ota/reconcile/bookings (which replaces ota-desk's direct `mcp_ro`
# PostgreSQL read). The browser UI keeps using /api/* unchanged.
#
# Master switch — SHIPS DARK. Off ⇒ every /api/ota/* request answers 503,
# whatever credential it carries. NOTE (ADR 0004): the operational value of
# this flag lives in docker-compose.yml, NOT in .github/workflows/
# docker-build.yml — adding it there would make the compose default
# unreachable dead code.
OTA_BRIDGE_ENABLED=false
# Require the bearer. OFF = PERMISSIVE migration mode: a request with NO
# Authorization header is served (with a WARN per request) so ota-desk can be
# cut over without a flag-flip race. A PRESENTED-BUT-WRONG bearer is 401 even
# in permissive mode — that is what makes flipping this to true provably safe
# once the "accepted WITHOUT a bearer token" WARN count has been zero for 24h.
OTA_BRIDGE_ENFORCE=false
# Shared bearer ota-desk presents as `Authorization: Bearer <token>`.
#
#   INVARIANT: this MUST hold the IDENTICAL string as ota-desk's
#   `PMS_BRIDGE_TOKEN`. Two names, one value (same idiom as
#   PORTAL_NOTIFY_TOKEN ≡ portal NOTIFY_INGRESS_TOKEN). Confirm without
#   exposing it: both sides print sha256(token)[0..6] — new-hotel in its
#   "OTA bridge: …" startup line, ota-desk via `pnpm pms:ping`.
#
# Generate with `openssl rand -hex 32`. Also available as Docker secret file
# `ota_bridge_token` (env wins).
OTA_BRIDGE_TOKEN=
# Rotation slot: still ACCEPTED, but every such request logs "finish the
# rotation". Set it to the OLD value while ota-desk moves to the new one, then
# clear it. Also available as Docker secret file `ota_bridge_token_previous`.
OTA_BRIDGE_TOKEN_PREVIOUS=

# =============================================================================
# /hk per-employee location enforcement (wave-4 housekeeping C)
# =============================================================================
# `HK_BRANCHES` (above) answers "which properties does this DEPLOYMENT serve".
# It never answered "which property does THIS MAID work at" — so `/api/hk/me`
# handed every maid the same allowlist and an HF Ville maid was offered HF
# Hotel in the picker, able to file a cleaning report (and, for `done`, a real
# MarkRoomClean writeback) against the WRONG PROPERTY.
#
# HF ID holds the authoritative answer in `Employee.location`. With this ON,
# `/api/hk/me` serves HK_BRANCHES ∩ {the employee's own location} and every
# room endpoint — READS AND MUTATIONS — refuses a branch that is not hers.
#
# SHIPS DARK. Off ⇒ no lookup is issued at all and the surface is
# byte-identical to the pre-enforcement build.
#
# Flipping this is NOT "just config": it can lock staff OUT. Anyone whose HF ID
# location is NULL is refused, by design and with NO fallback to the allowlist
# or to hfhotel. Preconditions in order (PENDING-VERIFICATIONS.md V14):
#   1. the owner sets every maid's location in HF ID (badge 421 is the only
#      NULL today), then
#   2. HFID_LOCATION_URL + HFID_RESOLVE_SECRET are both live, then
#   3. flip this and redeploy.
# With the flag on and the lookup unconfigured, EVERY /hk request answers 503
# (fail closed — "unconfigured" must never equal "allowed").
HK_LOCATION_ENFORCEMENT_ENABLED=false
# FULL URL of HF ID's badge → location endpoint, path INCLUDED:
#   http://192.168.100.228:5000/api/private/reader/resolve-badge
# (fingerprint-time-logger `app/api/reader.py`; POST {"badge":"…"} with the
# X-Reader-Secret header, answering {found, badge, display_name, apps, active,
# pending, location} where location is "HF" | "HF_VILLE" | null).
#
# A full URL rather than a base + hardcoded path, so a peer-side path change is
# a config edit rather than a code change. NO default: unset must read as
# "unconfigured" (⇒ 503), never as a lookup against a guessed path.
#
# LAN ONLY — never route this through Cloudflare. It is a server-to-server call
# inside the property network, in the request path of every /hk read.
HFID_LOCATION_URL=
# Shared secret for that lookup, sent as the `X-Reader-Secret` header.
#
#   INVARIANT: this holds the SAME VALUE as the estate's READER_RESOLVE_SECRET
#   (fingerprint-time-logger's own env var, and this file's READER_RESOLVE_SECRET
#   above). HF ID guards its whole app↔central surface — /resolve, /resolve-badge,
#   /claim, /wait — with ONE secret. The distinct name here exists so the two
#   consumers (card-login pairing, location lookup) stay independently rotatable.
#   Do not go looking for a separate upstream credential; there isn't one.
#
# Also available as Docker secret file `hfid_resolve_secret` (env wins).
# Unset/empty ⇒ no lookup client is built ⇒ 503 while enforcement is on.
HFID_RESOLVE_SECRET=
