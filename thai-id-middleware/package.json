{
  "name": "thai-id-middleware",
  "version": "1.1.5",
  "description": "Cross-platform desktop app with GUI that runs an HTTP middleware for Thai ID card reading",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "pcsclite": "^1.0.1",
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.6.0"
  },
  "build": {
    "appId": "com.hotel.thaiid-middleware",
    "productName": "Thai ID Middleware",
    "artifactName": "thai-id-middleware-${version}-${platform}.${ext}",
    "files": [
      "**/*",
      "!node_modules/**/README*",
      "!node_modules/**/CHANGELOG*"
    ],
    "mac": {
      "target": "dmg",
      "icon": "icon.png"
    },
    "win": {
      "target": "portable",
      "icon": "icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png",
      "category": "Utility"
    }
  }
}
